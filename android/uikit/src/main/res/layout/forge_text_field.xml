<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:id="@+id/forge_field_label"
        style="@style/Forge.Text.FieldLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/forge_field_input"
        style="@style/Forge.Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/forge_field_gap" />

    <TextView
        android:id="@+id/forge_field_helper"
        style="@style/Forge.Text.Hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/forge_field_gap"
        android:visibility="gone" />
</merge>
