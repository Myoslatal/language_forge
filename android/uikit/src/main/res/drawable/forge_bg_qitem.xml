<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item><shape android:shape="rectangle"><solid android:color="@color/forge_accent_soft" /></shape></item>
            <item android:width="2dp" android:gravity="start">
                <shape android:shape="rectangle"><solid android:color="@color/forge_accent" /></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/forge_panel2" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/forge_panel" /></shape>
    </item>
</selector>
