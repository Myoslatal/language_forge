<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/forge_accent_soft">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forge_panel" />
            <stroke android:width="1dp" android:color="@color/forge_line" />
            <corners android:radius="@dimen/forge_radius" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/forge_radius" />
        </shape>
    </item>
</ripple>
