<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/forge_panel3" />
            <stroke android:width="1dp" android:color="@color/forge_line" />
            <corners android:radius="@dimen/forge_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/forge_panel" />
            <stroke android:width="1dp" android:color="@color/forge_accent" />
            <corners android:radius="@dimen/forge_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forge_panel2" />
            <stroke android:width="1dp" android:color="@color/forge_line" />
            <corners android:radius="@dimen/forge_radius" />
        </shape>
    </item>
</selector>
