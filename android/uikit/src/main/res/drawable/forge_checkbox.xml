<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/forge_accent" />
                    <stroke android:width="1dp" android:color="@color/forge_accent" />
                    <corners android:radius="3dp" />
                    <size android:width="16dp" android:height="16dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/forge_ic_check_white" android:gravity="center" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/forge_panel2" />
            <stroke android:width="1dp" android:color="@color/forge_line" />
            <corners android:radius="3dp" />
            <size android:width="16dp" android:height="16dp" />
        </shape>
    </item>
</selector>
