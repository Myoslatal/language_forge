<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/structure_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/structure_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/structure_topbar_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_structure_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/structure_project_name"
                    style="@style/Forge.Text.Brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="项目" />

                <TextView
                    style="@style/Forge.Text.BrandSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="项目结构" />
            </LinearLayout>

            <io.github.myoslatal.languageforge.uikit.ForgeBadge
                android:id="@+id/structure_counts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="0 章 · 0 单元 · 0 课程"
                android:textSize="10sp"
                app:forgeTone="accent" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/structure_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/structure_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="项目结构"
                    android:textColor="@color/forge_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_new_chapter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 新建章节"
                    app:forgeVariant="primary" />
            </LinearLayout>

            <TextView
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="章节 → 单元 → 课程；点击行展开/收起。" />

            <LinearLayout
                android:id="@+id/structure_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/forge_bg_empty_state"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="章节"
                    android:src="@drawable/forge_ic_folder" />

                <TextView
                    android:id="@+id/structure_empty_title"
                    style="@style/Forge.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="还没有章节"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Forge.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点击右上角新建章节开始" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/structure_chapter_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
