<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/picker_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/picker_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/picker_topbar_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_picker_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <TextView
                android:id="@+id/picker_title"
                style="@style/Forge.Text.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="选择词汇" />

            <io.github.myoslatal.languageforge.uikit.ForgeBadge
                android:id="@+id/picker_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已选 0 个" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_picker_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="确定"
                android:textSize="11sp"
                app:forgeVariant="primary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/picker_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/picker_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/picker_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:forgeHint="搜索编码、文本、音标、Unicode 码点或释义" />

            <LinearLayout
                android:id="@+id/picker_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_picker_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一页"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />

                <TextView
                    android:id="@+id/picker_page"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="第 1 / 1 页 · 共 0 个匹配" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_picker_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一页"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/picker_page_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1"
                android:progress="0" />

            <LinearLayout
                android:id="@+id/picker_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/forge_bg_empty_state"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    style="@style/Forge.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="没有匹配词汇"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/picker_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
