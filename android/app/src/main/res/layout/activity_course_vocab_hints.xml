<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vocab_hints_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vocab_hints_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_vocab_hints_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Forge.Text.Brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="词汇提示覆盖" />

                <TextView
                    android:id="@+id/vocab_hints_context"
                    style="@style/Forge.Text.BrandSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="仅本课程" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/vocab_hints_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/vocab_hints_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="词汇提示覆盖"
                android:textColor="@color/forge_text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="只影响本课程复习时点词弹出的提示正文；全局词汇的音标、释义、图片和音频保持不变。" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_add_vocab_hint"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:text="＋ 添加覆盖"
                android:textSize="14sp"
                app:forgeVariant="primary" />

            <TextView
                android:id="@+id/vocab_hints_count"
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0 个词 · 仅本课程" />

            <LinearLayout
                android:id="@+id/vocab_hints_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/forge_bg_empty_state"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    style="@style/Forge.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="本课程还没有自定义提示"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Forge.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="添加后只在本课程复习点词时生效。" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vocab_hints_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
