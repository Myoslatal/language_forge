<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/course_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="7dp"
    android:paddingEnd="4dp"
    android:paddingBottom="7dp">

    <TextView
        style="@style/Forge.Text.Tpill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="课程" />

    <TextView
        android:id="@+id/course_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/forge_text"
        android:textSize="13sp" />

    <io.github.myoslatal.languageforge.uikit.ForgeButton
        android:id="@+id/course_more"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:contentDescription="课程菜单"
        app:forgeIcon="@drawable/forge_ic_more"
        app:forgeVariant="ghost" />
</LinearLayout>
