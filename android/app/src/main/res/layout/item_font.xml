<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/forge_bg_project_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/font_name"
            style="@style/Forge.Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="字体" />

        <TextView
            android:id="@+id/font_meta"
            style="@style/Forge.Text.Tiny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="font.ttf · 0 KB" />
    </LinearLayout>

    <io.github.myoslatal.languageforge.uikit.ForgeBadge
        android:id="@+id/font_current"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="当前"
        android:visibility="gone" />

    <io.github.myoslatal.languageforge.uikit.ForgeButton
        android:id="@+id/font_more"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="字体菜单"
        android:text="⋯"
        android:textSize="16sp"
        app:forgeVariant="ghost" />
</LinearLayout>
