<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/question_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/question_editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/btn_question_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="返回"
            app:forgeIcon="@drawable/forge_ic_back"
            app:forgeVariant="ghost" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/question_editor_title"
                style="@style/Forge.Text.Brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="新建题目" />

            <TextView
                android:id="@+id/question_editor_subtitle"
                style="@style/Forge.Text.Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择正确翻译" />
        </LinearLayout>

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/btn_save_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保存"
            android:textSize="11sp"
            app:forgeVariant="primary" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/question_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <TextView
                style="@style/Forge.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="句子词汇" />

            <TextView
                android:id="@+id/question_sentence"
                style="@style/Forge.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="尚未选择词汇"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/question_parts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_choose_question_parts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="选择词汇"
                app:forgeVariant="secondary" />

            <TextView
                style="@style/Forge.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="整句录音" />

            <TextView
                android:id="@+id/question_audio_hint"
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="可选；录制整句示例发音。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_question_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="录制"
                    app:forgeVariant="secondary" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_question_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="播放"
                    app:forgeVariant="ghost" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_question_remove_audio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="移除"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <TextView
                style="@style/Forge.Text.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="四个选项（选择一个正确答案）" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/question_option_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:forgeHint="选项 1" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/question_option_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:forgeHint="选项 2" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/question_option_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:forgeHint="选项 3" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/question_option_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:forgeHint="选项 4" />

            <RadioGroup
                android:id="@+id/question_correct_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/question_correct_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选项 1 是正确答案" />

                <RadioButton
                    android:id="@+id/question_correct_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选项 2 是正确答案" />

                <RadioButton
                    android:id="@+id/question_correct_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选项 3 是正确答案" />

                <RadioButton
                    android:id="@+id/question_correct_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="选项 4 是正确答案" />
            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
