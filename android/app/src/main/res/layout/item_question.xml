<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/question_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/forge_bg_project_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/question_index"
        style="@style/Forge.Text.Mono"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="01"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/question_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/forge_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/question_type"
        style="@style/Forge.Text.Tpill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:text="选择正确翻译" />

    <io.github.myoslatal.languageforge.uikit.ForgeButton
        android:id="@+id/question_more"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:contentDescription="题目菜单"
        app:forgeIcon="@drawable/forge_ic_more"
        app:forgeVariant="ghost" />
</LinearLayout>
