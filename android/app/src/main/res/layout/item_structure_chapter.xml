<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chapter_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/forge_bg_project_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/chapter_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="11dp"
        android:paddingEnd="6dp"
        android:paddingBottom="11dp">

        <ImageView
            android:id="@+id/chapter_chevron"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="展开章节"
            android:src="@drawable/forge_ic_chevron_right" />

        <TextView
            android:id="@+id/chapter_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/forge_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <io.github.myoslatal.languageforge.uikit.ForgeBadge
            android:id="@+id/chapter_units"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0 个单元" />

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/chapter_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="章节菜单"
            app:forgeIcon="@drawable/forge_ic_more"
            app:forgeVariant="ghost" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chapter_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/chapter_empty"
            style="@style/Forge.Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:text="本章还没有单元"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/chapter_unit_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>
