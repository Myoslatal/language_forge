<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/unit_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="5dp"
    android:background="@drawable/forge_bg_project_chip"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/unit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingTop="9dp"
        android:paddingEnd="5dp"
        android:paddingBottom="9dp">

        <ImageView
            android:id="@+id/unit_chevron"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:contentDescription="展开单元"
            android:src="@drawable/forge_ic_chevron_right" />

        <TextView
            android:id="@+id/unit_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/forge_text"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <io.github.myoslatal.languageforge.uikit.ForgeBadge
            android:id="@+id/unit_courses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="0 门课程" />

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/unit_more"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:contentDescription="单元菜单"
            app:forgeIcon="@drawable/forge_ic_more"
            app:forgeVariant="ghost" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/unit_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="5dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/unit_empty"
            style="@style/Forge.Text.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="本单元还没有课程"
            android:textSize="11sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/unit_course_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>