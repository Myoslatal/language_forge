<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/unit_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/forge_bg_unit"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/unit_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="01"
        android:textColor="@color/forge_muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/unit_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="第 1 关 · 问候与身份"
        android:textColor="@color/forge_unit_title"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/unit_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="monospace"
        android:includeFontPadding="false"
        android:text="10 题"
        android:textColor="@color/forge_muted"
        android:textSize="9.5sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:text="⋯"
        android:textColor="@color/forge_muted"
        android:textSize="11sp" />
</LinearLayout>
