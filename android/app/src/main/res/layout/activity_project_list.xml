<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/project_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topbar_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/forge_square_accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Forge.Text.Brand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="@string/brand_name" />

                    <TextView
                        style="@style/Forge.Text.BrandSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:text="项目管理" />
                </LinearLayout>
            </LinearLayout>

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/cd_theme"
                app:forgeIcon="@drawable/forge_ic_theme"
                app:forgeVariant="ghost" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_overflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:contentDescription="更多菜单"
                app:forgeIcon="@drawable/forge_ic_menu"
                app:forgeVariant="ghost" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/project_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/project_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="我的项目"
                    android:textColor="@color/forge_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <io.github.myoslatal.languageforge.uikit.ForgeBadge
                    android:id="@+id/project_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:text="0"
                    app:forgeTone="accent" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_import_project"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:text="导入"
                    app:forgeIcon="@drawable/forge_ic_folder"
                    app:forgeVariant="default" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_new_project"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 新建项目"
                    app:forgeVariant="primary" />
            </LinearLayout>

            <TextView
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="管理语言课程项目；项目元数据保存在 App 专属外部目录。" />

            <LinearLayout
                android:id="@+id/pinned_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Forge.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="置顶" />

                    <io.github.myoslatal.languageforge.uikit.ForgeBadge
                        android:id="@+id/pinned_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="0"
                        app:forgeTone="accent" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pinned_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/all_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Forge.Text.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部项目" />

                    <io.github.myoslatal.languageforge.uikit.ForgeBadge
                        android:id="@+id/all_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="0" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/all_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/forge_bg_empty_state"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="空项目"
                    android:importantForAccessibility="no"
                    android:src="@drawable/forge_ic_folder"
                    android:tint="@color/forge_faint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif"
                    android:text="还没有项目"
                    android:textColor="@color/forge_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Forge.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="新建一个项目开始制作关卡" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_empty_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="＋ 新建项目"
                    app:forgeVariant="primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/data_path_note"
                style="@style/Forge.Text.Tiny"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="项目数据：/sdcard/Android/data/io.github.myoslatal.languageforge/files/projects"
                android:textColor="@color/forge_faint"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>