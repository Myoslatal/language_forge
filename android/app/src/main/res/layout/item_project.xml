<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/project_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/forge_bg_project_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/project_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/forge_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/project_pin"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:contentDescription="置顶"
            app:forgeIcon="@drawable/forge_ic_pin"
            app:forgeVariant="ghost" />

        <io.github.myoslatal.languageforge.uikit.ForgeButton
            android:id="@+id/project_more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="项目菜单"
            app:forgeIcon="@drawable/forge_ic_more"
            app:forgeVariant="ghost" />
    </LinearLayout>

    <TextView
        android:id="@+id/project_course"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/forge_muted"
        android:textSize="10.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <io.github.myoslatal.languageforge.uikit.ForgeBadge
            android:id="@+id/project_lessons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 关" />

        <io.github.myoslatal.languageforge.uikit.ForgeBadge
            android:id="@+id/project_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="0 题" />

        <io.github.myoslatal.languageforge.uikit.ForgeBadge
            android:id="@+id/project_words"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="0 词" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/project_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textColor="@color/forge_faint"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
