<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vocab_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vocab_editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/vocab_editor_topbar_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_vocab_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <TextView
                android:id="@+id/vocab_editor_title"
                style="@style/Forge.Text.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="新建词汇" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_vocab_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                app:forgeVariant="primary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/vocab_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/vocab_editor_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/pos_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Forge.Text.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="词性" />

                <TextView
                    android:id="@+id/pos_hint"
                    style="@style/Forge.Text.Tiny"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="可多选；选择后按词性分别填写释义。" />

                <LinearLayout
                    android:id="@+id/pos_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/meanings_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Forge.Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="释义" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_add_meaning"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 添加"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/meanings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Forge.Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="编码" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_add_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 添加"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/codes_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Forge.Text.SectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="音标（可多个）" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_add_phonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="＋ 添加音标"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/phonetics_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <io.github.myoslatal.languageforge.uikit.ForgeSelect
                android:id="@+id/vocab_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:forgeLabel="类型" />

            <LinearLayout
                android:id="@+id/text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <io.github.myoslatal.languageforge.uikit.ForgeTextField
                    android:id="@+id/vocab_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:forgeLabel="文本词语"
                    app:forgeHint="例如：apple" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/unicode_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Forge.Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Unicode 码点" />

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_add_codepoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="＋ 添加"
                        android:textSize="11sp"
                        app:forgeVariant="ghost" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/codepoints_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/unicode_preview"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="预览：—" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/combo_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Forge.Text.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="组合部分" />

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_pick_parts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择词汇"
                        android:textSize="11sp"
                        app:forgeVariant="default" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/combo_selected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/combo_preview"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="已选 0 个部分（至少 2 个）" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/image_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/forge_bg_card"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/image_hint"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="导入图片或手绘文字；图片会保存为项目资源。" />

                <LinearLayout
                    android:id="@+id/image_empty_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_import_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入图片"
                        android:textSize="11sp"
                        app:forgeVariant="default" />

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_draw_image"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="手绘文字"
                        android:textSize="11sp"
                        app:forgeVariant="default" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/image_preview_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/image_preview"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="8dp"
                        android:background="@color/forge_panel2"
                        android:contentDescription="自定义文字预览"
                        android:scaleType="fitCenter" />

                    <TextView
                        android:id="@+id/image_size"
                        style="@style/Forge.Text.Tiny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0 × 0 px" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_reimport_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="重新导入"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_redraw_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="重新绘制"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_remove_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="移除"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/audio_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/forge_bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    style="@style/Forge.Text.Brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="示例发音" />

                <TextView
                    android:id="@+id/audio_hint"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="可选；导入音频或现场录制，播放与裁剪会遵守区间。" />

                <LinearLayout
                    android:id="@+id/audio_empty_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_import_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="导入音频"
                        android:textSize="11sp"
                        app:forgeVariant="default" />

                    <io.github.myoslatal.languageforge.uikit.ForgeButton
                        android:id="@+id/btn_record_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="录制音频"
                        android:textSize="11sp"
                        app:forgeVariant="default" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/audio_ready_box"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/audio_name"
                        style="@style/Forge.Text.Tiny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="audio.m4a" />

                    <TextView
                        android:id="@+id/audio_duration"
                        style="@style/Forge.Text.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="时长：0.0s" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_play_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="播放"
                            android:textSize="11sp"
                            app:forgeVariant="on" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_remove_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="移除"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_reimport_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="重新导入"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_rerecord_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="重录"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/audio_trim_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/audio_start_label"
                            style="@style/Forge.Text.Tiny"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="开始：0.0s" />

                        <SeekBar
                            android:id="@+id/audio_start_seek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="1000"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/audio_end_label"
                            style="@style/Forge.Text.Tiny"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="结束：0.0s" />

                        <SeekBar
                            android:id="@+id/audio_end_seek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="1000"
                            android:progress="1000" />

                        <TextView
                            android:id="@+id/audio_range_text"
                            style="@style/Forge.Text.Hint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="区间：0.0 – 0.0s / 0.0s" />

                        <io.github.myoslatal.languageforge.uikit.ForgeButton
                            android:id="@+id/btn_preview_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="试听裁剪"
                            android:textSize="11sp"
                            app:forgeVariant="ghost" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>