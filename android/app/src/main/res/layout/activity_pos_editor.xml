<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pos_editor_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pos_editor_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_pos_editor_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <TextView
                android:id="@+id/pos_editor_title"
                style="@style/Forge.Text.Brand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="新建词性" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_pos_editor_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存"
                app:forgeVariant="primary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/pos_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="词性用于描述词汇类别；名称必填，描述和编码可空。" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/pos_field_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:forgeHint="例如：名词、动词"
                app:forgeLabel="名称" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/pos_field_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:forgeHint="例如：表示人、事物、地点等"
                app:forgeLabel="描述"
                app:forgeMultiline="true" />

            <io.github.myoslatal.languageforge.uikit.ForgeTextField
                android:id="@+id/pos_field_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:forgeHint="例如：n、v"
                app:forgeLabel="编码" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
