<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vocabulary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forge_bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/vocabulary_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/forge_bg_topbar"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/vocabulary_topbar_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_vocabulary_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="返回"
                app:forgeIcon="@drawable/forge_ic_back"
                app:forgeVariant="ghost" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Forge.Text.Brand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="词汇表" />

                <TextView
                    android:id="@+id/vocabulary_project"
                    style="@style/Forge.Text.BrandSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="项目" />
            </LinearLayout>

            <io.github.myoslatal.languageforge.uikit.ForgeBadge
                android:id="@+id/vocabulary_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0" />

            <io.github.myoslatal.languageforge.uikit.ForgeButton
                android:id="@+id/btn_new_vocabulary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="＋ 新建词汇"
                android:textSize="11sp"
                app:forgeVariant="primary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/vocabulary_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/vocabulary_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="14dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="项目级共享词汇；点击词汇编辑，⋯ 删除。" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <io.github.myoslatal.languageforge.uikit.ForgeTextField
                    android:id="@+id/vocabulary_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:forgeHint="搜索显示名/编码/音标/释义/词性" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_import_lexicon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="导入词表"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <TextView
                android:id="@+id/vocabulary_visible"
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/vocabulary_pager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_vocabulary_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="上一页"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />

                <TextView
                    android:id="@+id/vocabulary_page"
                    style="@style/Forge.Text.Hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="第 1 / 1 页" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_vocabulary_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="下一页"
                    android:textSize="11sp"
                    app:forgeVariant="ghost" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/vocabulary_page_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="1"
                android:progress="0" />

            <TextView
                android:id="@+id/vocabulary_no_match"
                style="@style/Forge.Text.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="没有匹配的词汇"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/vocabulary_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/forge_bg_empty_state"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="词汇"
                    android:src="@drawable/forge_ic_folder" />

                <TextView
                    style="@style/Forge.Text.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="还没有词汇"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Forge.Text.Hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="新建第一条词汇开始" />

                <io.github.myoslatal.languageforge.uikit.ForgeButton
                    android:id="@+id/btn_empty_vocabulary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="＋ 新建词汇"
                    app:forgeVariant="primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/vocabulary_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>